<?xml version="1.0"?>
<!--
  test_arm.urdf — placeholder 6-DOF test arm, NOT the real deployment robot.
  See README.md in this directory. Inertials are dummy-but-valid (positive
  definite) since this is used for kinematics (IK + FK replay), not dynamics.
-->
<robot name="struct_test_arm">

  <!-- MuJoCo's URDF importer fuses statically-connected bodies (e.g. links
       joined by a "fixed" joint, like end_effector below) into their parent
       by default, which would silently delete the end_effector body we need
       to query. Disable that fusion. -->
  <mujoco>
    <compiler fusestatic="false"/>
  </mujoco>

  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.08" length="0.1"/></geometry>
    </visual>
  </link>

  <link name="shoulder_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.06" length="0.08"/></geometry>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0.2 0 0"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
    </visual>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9199" upper="1.9199" effort="100" velocity="3.0"/>
  </joint>

  <link name="forearm_link">
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0.2 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.025"/>
    </inertial>
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.035" length="0.4"/></geometry>
    </visual>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7925" upper="2.7925" effort="80" velocity="3.0"/>
  </joint>

  <link name="wrist1_link">
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
    </visual>
  </link>

  <joint name="wrist1" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist1_link"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="40" velocity="4.0"/>
  </joint>

  <link name="wrist2_link">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry>
    </visual>
  </link>

  <joint name="wrist2" type="revolute">
    <parent link="wrist1_link"/>
    <child link="wrist2_link"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9199" upper="1.9199" effort="40" velocity="4.0"/>
  </joint>

  <link name="wrist3_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.02" length="0.04"/></geometry>
    </visual>
  </link>

  <joint name="wrist3" type="revolute">
    <parent link="wrist2_link"/>
    <child link="wrist3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="40" velocity="4.0"/>
  </joint>

  <!-- Fixed tip frame — this is the "end_effector" pose retarget solves for. -->
  <link name="end_effector">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wrist3_to_ee" type="fixed">
    <parent link="wrist3_link"/>
    <child link="end_effector"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
  </joint>

</robot>
