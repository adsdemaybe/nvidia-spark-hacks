#!/usr/bin/env python3
"""Interactive quadruped viewer. Run with mjpython on macOS.

  mjpython sim/quad/walk            hold the stance, sliders are yours
  mjpython sim/quad/walk --trot     drive a trot gait
"""
import os, sys, time, math
import mujoco, mujoco.viewer

HERE = os.path.dirname(os.path.abspath(__file__))
m = mujoco.MjModel.from_xml_path(os.path.join(HERE, "quad.xml"))
d = mujoco.MjData(m)
mujoco.mj_resetDataKeyframe(m, d, 0)
base = [float(v) for v in m.key_ctrl[0]]
d.ctrl[:] = base

TROT = "--trot" in sys.argv
LEGS = ["fl", "fr", "rl", "rr"]
PHASE = {"fl": 0.0, "rr": 0.0, "fr": math.pi, "rl": math.pi}   # diagonal pairs
idx = {}
for lg in LEGS:
    idx[lg] = [mujoco.mj_name2id(m, mujoco.mjtObj.mjOBJ_ACTUATOR, f"{j}_{lg}")
               for j in ("abduct", "hip", "knee")]

print(f"quadruped: {m.nbody} bodies, {m.nu} actuators, {m.body_mass.sum():.2f} kg")
print("trot gait" if TROT else "holding stance — Control panel sliders are live")

with mujoco.viewer.launch_passive(m, d) as v:
    t0 = time.time()
    while v.is_running():
        step_start = time.time()
        if TROT:
            t = time.time() - t0
            for lg in LEGS:
                ph = 2 * math.pi * 1.4 * t + PHASE[lg]
                a_i, h_i, k_i = idx[lg]
                lift = max(0.0, math.sin(ph))
                d.ctrl[h_i] = base[h_i] + 0.22 * math.cos(ph)
                d.ctrl[k_i] = base[k_i] - 0.45 * lift
        mujoco.mj_step(m, d)
        v.sync()
        dt = m.opt.timestep - (time.time() - step_start)
        if dt > 0:
            time.sleep(dt)
