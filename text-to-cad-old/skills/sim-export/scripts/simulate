#!/usr/bin/env python3
"""Run the exported robot in MuJoCo — interactively, or recorded to video.

Builds a runnable scene from the URDF: floating base, ground plane, lighting,
and actuators the URDF does not carry (URDF has no actuator element, so a
position/velocity layer is added here).

    simulate --viewer            open the interactive MuJoCo viewer
    simulate --record out.mp4    run a scripted rollout and record it
    simulate --scene out.xml     dump the runnable MJCF for inspection
"""
from __future__ import annotations

import argparse
import math
import sys

from _common import bootstrap

# Arm joints get position servos; wheels get velocity servos.
ARM_JOINTS = ("yaw", "shoulder", "elbow")
JAW_JOINTS = ("jaw_a", "jaw_b")
WHEEL_JOINTS = ("axle_0", "axle_1", "axle_2", "axle_3")

ARM_KP, ARM_KV = 220.0, 22.0
JAW_KP, JAW_KV = 900.0, 30.0
WHEEL_KV = 6.0


def build_scene(urdf: str):
    """URDF -> a runnable MuJoCo model: floating base, floor, lights, actuators."""
    import mujoco

    spec = mujoco.MjSpec.from_file(urdf)

    # A URDF root is welded to the world by the importer, which also silently
    # drops the base link's mass. A mobile robot needs a free joint.
    base = next(b for b in spec.bodies if b.name == "base_link")
    base.add_freejoint()

    spec.worldbody.add_geom(
        type=mujoco.mjtGeom.mjGEOM_PLANE, size=[8.0, 8.0, 0.05],
        pos=[0, 0, 0], rgba=[0.32, 0.34, 0.36, 1.0])
    # The default offscreen framebuffer is 640x480; recording wants more.
    spec.visual.global_.offwidth = 1920
    spec.visual.global_.offheight = 1080

    spec.worldbody.add_light(pos=[0.7, -0.7, 1.6], dir=[-0.35, 0.35, -1.0],
                             diffuse=[0.75, 0.74, 0.72],
                             specular=[0.25, 0.25, 0.25])
    spec.worldbody.add_light(pos=[-1.1, 0.9, 1.3], dir=[0.5, -0.45, -1.0],
                             diffuse=[0.42, 0.45, 0.5], specular=[0.1, 0.1, 0.1])
    spec.visual.headlight.ambient = [0.42, 0.42, 0.44]
    spec.visual.headlight.diffuse = [0.35, 0.35, 0.35]

    # Collision primitives would render on top of the visual meshes. MuJoCo
    # shows geom groups 0-2 by default, so park the colliders in group 3:
    # the STL visuals become what you actually see, which is the whole point
    # of keeping them through the export.
    for g in spec.geoms:
        if g.type != mujoco.mjtGeom.mjGEOM_MESH and g.type != mujoco.mjtGeom.mjGEOM_PLANE:
            g.group = 3
        elif g.type == mujoco.mjtGeom.mjGEOM_MESH:
            g.rgba = [0.78, 0.55, 0.28, 1.0]

    def servo(joint, kp, kv, lo, hi):
        a = spec.add_actuator()
        a.name = f"act_{joint}"
        a.target = joint
        a.trntype = mujoco.mjtTrn.mjTRN_JOINT
        a.gaintype = mujoco.mjtGain.mjGAIN_FIXED
        a.biastype = mujoco.mjtBias.mjBIAS_AFFINE
        a.gainprm = [kp] + [0.0] * 9
        a.biasprm = [0.0, -kp, -kv] + [0.0] * 7
        a.ctrllimited = 1
        a.ctrlrange = [lo, hi]
        return a

    def motor(joint, kv, lim):
        a = spec.add_actuator()
        a.name = f"act_{joint}"
        a.target = joint
        a.trntype = mujoco.mjtTrn.mjTRN_JOINT
        a.gaintype = mujoco.mjtGain.mjGAIN_FIXED
        a.biastype = mujoco.mjtBias.mjBIAS_AFFINE
        a.gainprm = [kv] + [0.0] * 9
        a.biasprm = [0.0, 0.0, -kv] + [0.0] * 7
        a.ctrllimited = 1
        a.ctrlrange = [-lim, lim]
        return a

    by_name = {j.name: j for j in spec.joints}
    for j in ARM_JOINTS:
        if j in by_name:
            lo, hi = by_name[j].range
            servo(j, ARM_KP, ARM_KV, lo, hi)
    for j in JAW_JOINTS:
        if j in by_name:
            lo, hi = by_name[j].range
            servo(j, JAW_KP, JAW_KV, lo, hi)
    for j in WHEEL_JOINTS:
        if j in by_name:
            motor(j, WHEEL_KV, 12.0)

    return spec


def spawn(model):
    import mujoco
    d = mujoco.MjData(model)
    mujoco.mj_resetDataKeyframe(model, d, 0) if model.nkey else mujoco.mj_resetData(model, d)
    d.qpos[2] = 0.06
    mujoco.mj_forward(model, d)
    return d


def hold_pose(model, d):
    """Seed ctrl with the stowed pose so --manual does not start in a flop."""
    import mujoco
    for name, val in (("act_shoulder", -1.45), ("act_elbow", 2.55)):
        i = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_ACTUATOR, name)
        if i >= 0:
            d.ctrl[i] = val


def script_at(t: float) -> dict:
    """A scripted demo: settle, drive, then sweep the arm and work the gripper."""
    if t < 1.0:                                   # settle on its wheels
        return dict(drive=0.0, yaw=0.0, shoulder=-1.45, elbow=2.55, jaw=0.0)
    if t < 4.0:                                   # drive forward, arm stowed
        return dict(drive=7.0, yaw=0.0, shoulder=-1.45, elbow=2.55, jaw=0.0)
    if t < 5.0:                                   # brake
        return dict(drive=0.0, yaw=0.0, shoulder=-1.45, elbow=2.55, jaw=0.0)
    if t < 8.0:                                   # deploy to reach
        k = min(1.0, (t - 5.0) / 2.5)
        return dict(drive=0.0, yaw=0.0,
                    shoulder=-1.45 + k * 1.30, elbow=2.55 - k * 2.10,
                    jaw=0.007 * k)
    if t < 11.0:                                  # yaw sweep
        k = (t - 8.0) / 3.0
        return dict(drive=0.0, yaw=math.sin(k * math.pi * 2) * 1.1,
                    shoulder=-0.15, elbow=0.45, jaw=0.007)
    if t < 13.0:                                  # close the jaws
        return dict(drive=0.0, yaw=0.0, shoulder=-0.15, elbow=0.45,
                    jaw=max(0.0, 0.007 * (1.0 - (t - 11.0) / 1.2)))
    k = min(1.0, (t - 13.0) / 2.0)                # restow
    return dict(drive=0.0, yaw=0.0, shoulder=-0.15 - k * 1.30,
                elbow=0.45 + k * 2.10, jaw=0.0)


def apply(model, d, cmd):
    import mujoco
    def setc(name, v):
        i = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_ACTUATOR, name)
        if i >= 0:
            d.ctrl[i] = v
    setc("act_yaw", cmd["yaw"])
    setc("act_shoulder", cmd["shoulder"])
    setc("act_elbow", cmd["elbow"])
    setc("act_jaw_a", cmd["jaw"])
    setc("act_jaw_b", cmd["jaw"])
    for w in WHEEL_JOINTS:
        setc(f"act_{w}", cmd["drive"])


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("urdf", nargs="?", default="sim/rover.urdf")
    ap.add_argument("--viewer", action="store_true",
                    help="open the interactive MuJoCo viewer (needs a display)")
    ap.add_argument("--manual", action="store_true",
                    help="with --viewer, do not drive the actuators; the "
                         "viewer's Control sliders take over")
    ap.add_argument("--record", metavar="OUT",
                    help="render a scripted rollout to .mp4 or .gif")
    ap.add_argument("--scene", metavar="XML", help="dump the runnable MJCF")
    ap.add_argument("--duration", type=float, default=15.0)
    ap.add_argument("--fps", type=int, default=30)
    ap.add_argument("--width", type=int, default=960)
    ap.add_argument("--height", type=int, default=640)
    a = ap.parse_args()

    bootstrap()
    import mujoco

    spec = build_scene(a.urdf)
    model = spec.compile()
    print(f"scene: {model.nbody} bodies, {model.nu} actuators, {model.ngeom} geoms")

    if a.scene:
        with open(a.scene, "w") as f:
            f.write(spec.to_xml())
        print(f"wrote {a.scene}")

    if a.viewer:
        import mujoco.viewer
        d = spawn(model)
        hold_pose(model, d)
        print("interactive viewer opening.")
        print("  orbit: drag        pan: shift-drag       zoom: scroll")
        print("  push a body: double-click it, then ctrl-drag")
        print("  drive the joints: open the Control panel (left strip) and move")
        print("     act_yaw / act_shoulder / act_elbow / act_jaw_* /")
        print("     act_axle_0..3 (wheel velocity)")
        if not a.manual:
            print("  NOTE: a scripted demo is driving the actuators; pass "
                  "--manual to take the sliders yourself.")
        print("  close the window to exit.")
        with mujoco.viewer.launch_passive(model, d) as v:
            import time
            t0 = time.time()
            while v.is_running():
                t = time.time() - t0
                if not a.manual:
                    apply(model, d, script_at(t % a.duration))
                mujoco.mj_step(model, d)
                v.sync()
                time.sleep(max(0.0, model.opt.timestep - 0.0002))
        return 0

    if a.record:
        import imageio.v2 as imageio
        import numpy as np
        d = spawn(model)
        renderer = mujoco.Renderer(model, height=a.height, width=a.width)
        cam = mujoco.MjvCamera()
        cam.distance, cam.elevation, cam.azimuth = 1.35, -18.0, 132.0
        cam.lookat[:] = [0.0, 0.0, 0.10]

        frames, next_frame = [], 0.0
        steps = int(a.duration / model.opt.timestep)
        for i in range(steps):
            t = i * model.opt.timestep
            apply(model, d, script_at(t))
            mujoco.mj_step(model, d)
            if t >= next_frame:
                cam.lookat[0] = float(d.qpos[0])      # follow the rover
                cam.lookat[1] = float(d.qpos[1])
                cam.azimuth = 132.0 + 6.0 * math.sin(t * 0.25)
                renderer.update_scene(d, camera=cam)
                frames.append(renderer.render())
                next_frame += 1.0 / a.fps
        if a.record.endswith(".gif"):
            imageio.mimsave(a.record, frames, fps=a.fps, loop=0)
        else:
            imageio.mimsave(a.record, frames, fps=a.fps, quality=8)
        print(f"wrote {a.record}  ({len(frames)} frames, {a.duration:.0f}s)")
        print(f"final base position: x={d.qpos[0]:.3f} y={d.qpos[1]:.3f} "
              f"z={d.qpos[2]:.3f} m")
        return 0

    print("nothing to do — pass --viewer, --record OUT, or --scene XML")
    return 2


if __name__ == "__main__":
    sys.exit(main())
